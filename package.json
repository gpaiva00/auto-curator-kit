{
  "name": "auto-curator-kit",
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/entries/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entries/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/entries/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./sources": {
      "types": "./dist/entries/sources.d.ts",
      "import": "./dist/sources.js"
    },
    "./publishers": {
      "types": "./dist/entries/publishers.d.ts",
      "import": "./dist/publishers.js"
    },
    "./testing": {
      "types": "./dist/entries/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "scripts",
    "profiles"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create": "tsx packages/cli/src/main.ts create",
    "doctor": "tsx packages/cli/src/main.ts doctor",
    "scan": "tsx packages/cli/src/main.ts scan",
    "dry-run": "tsx packages/cli/src/main.ts dry-run",
    "eval": "tsx packages/cli/src/main.ts eval",
    "start": "tsx packages/cli/src/main.ts start",
    "status": "tsx packages/cli/src/main.ts status",
    "build": "node tools/build.mjs",
    "smoke": "node tools/smoke.mjs",
    "release": "node tools/release.mjs",
    "release:publish": "node tools/release-publish.mjs",
    "release:verify": "node tools/release-verify.mjs"
  },
  "dependencies": {
    "zod": "^3.25.0",
    "satori": "^0.12.0",
    "sharp": "^0.35.5",
    "playwright-core": "^1.49.0",
    "@resvg/resvg-js": "^2.6.2",
    "@fontsource/inter": "^5.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.13",
  "peerDependencies": {
    "@types/node": ">=22"
  },
  "bin": {
    "auto-curator": "./dist/bin.js"
  }
}
