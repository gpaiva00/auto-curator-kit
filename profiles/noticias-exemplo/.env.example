# Copie para .env e preencha. Nunca commite o .env com valores reais.

# --- Telegram (um bot por perfil, criado no @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Ids dos chats autorizados a aprovar, separados por vírgula
TELEGRAM_ALLOWED_CHAT_IDS=

# --- LLM (Groq é o principal; os demais são fallback automático em caso de 402/429/5xx) ---
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Buffer (rascunhos no Instagram e no TikTok) ---
BUFFER_API_KEY=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_TIKTOK=

# --- Chrome dedicado via CDP (fonte "instagram-profile"; use uma conta de leitura, não a principal) ---
BROWSER_CDP_URL=http://127.0.0.1:9222

# --- Hospedagem de mídia para o Buffer (opcional: escolha uma) ---
IMGBB_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# --- Log: debug | info | warn | error ---
LOG_LEVEL=info
