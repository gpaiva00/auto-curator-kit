{
  "name": "thought-leader",
  "description": "Perfil de autoridade em texto (ex.: LinkedIn): reescreve ideias vistas em outras fontes como conteúdo próprio do dono, sem citar a origem, com mídia original e aprovação no Telegram. Herdado do linkedin-curador; voz e assuntos ficam no style-guide.md do perfil.",
  "draftExtraRequired": [],
  "defaults": {
    "language": "pt-BR",
    "media": { "strategy": "original", "maxImages": 4, "downloadVideo": true, "maxVideoSec": 300 },
    "editorial": {
      "credit": "hide",
      "riskFlags": ["confidential", "controversial", "personal", "attack", "unverified", "outdated"],
      "forceReview": ["confidential", "controversial", "personal", "attack", "unverified", "outdated"],
      "skip": [],
      "body": { "minChars": 20, "maxChars": 3000 },
      "headline": { "maxChars": 100 },
      "hashtags": { "min": 3, "max": 5 },
      "firstComment": true,
      "minConfidence": 0.6
    },
    "pipeline": {
      "triageMinScore": 60,
      "maxItemAgeHours": 24,
      "maxPendingApproval": 3,
      "dailyApprovalCap": 4
    }
  }
}
