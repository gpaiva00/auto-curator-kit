{
  "name": "auto-curator-kit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create": "tsx packages/cli/src/main.ts create",
    "doctor": "tsx packages/cli/src/main.ts doctor",
    "scan": "tsx packages/cli/src/main.ts scan",
    "dry-run": "tsx packages/cli/src/main.ts dry-run",
    "eval": "tsx packages/cli/src/main.ts eval",
    "start": "tsx packages/cli/src/main.ts start",
    "status": "tsx packages/cli/src/main.ts status"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "bun@1.3.13"
}
