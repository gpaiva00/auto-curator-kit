# Copie para .env e preencha. Este arquivo nunca deve ser commitado com valores reais.

# --- Telegram (um bot por perfil, criado no @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Ids dos chats autorizados a aprovar, separados por vírgula (use @userinfobot para descobrir o seu)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- LLM (Groq é o principal; os demais são fallback automático em caso de 402/429/5xx) ---
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Buffer (publicação como rascunho no Instagram) ---
BUFFER_API_KEY=
# Id do canal do Instagram no Buffer
BUFFER_CHANNEL_INSTAGRAM=

# --- Hospedagem de mídia para o Buffer (opcional: escolha uma) ---
IMGBB_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# --- Log: debug | info | warn | error ---
LOG_LEVEL=info
